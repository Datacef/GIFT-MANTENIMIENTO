# ================================================================
# Sistema de Gestión de Mantenimiento — Plantilla para entorno local
#
# OBLIGATORIO: copiar como .env.local y REEMPLAZAR TODOS los valores
# CAMBIAR_ESTO_* por credenciales propias. Usar los MISMOS valores de
# Parse y MongoDB que en .env (este archivo apunta el frontend local
# al backend).
#
#   cp .env.local.example .env.local      (Linux/macOS/Git Bash)
#   copy .env.local.example .env.local    (Windows CMD)
#
# ================================================================

# --- Parse Server ---
PARSE_APP_ID=CAMBIAR_ESTO_APP_ID
PARSE_MASTER_KEY=CAMBIAR_ESTO_MASTER_KEY_MIN_32_CARACTERES
PARSE_JS_KEY=CAMBIAR_ESTO_JS_KEY_MIN_32_CARACTERES

# --- MongoDB ---
MONGO_ROOT_USER=CAMBIAR_ESTO_USUARIO_MONGO
MONGO_ROOT_PASSWORD=CAMBIAR_ESTO_PASSWORD_MONGO_MIN_12_CARACTERES
MONGO_DB=mantenimiento

# --- URLs internas (Docker network) ---
PARSE_SERVER_URL=http://backend-server:1337/parse
PARSE_PUBLIC_SERVER_URL=http://localhost:5771/api/parse

# --- Admin inicial (se crea en el primer arranque) ---
DEFAULT_ADMIN_USER=CAMBIAR_ESTO_USUARIO_ADMIN
DEFAULT_ADMIN_PASS=CAMBIAR_ESTO_PASSWORD_ADMIN_MIN_10_CARACTERES
DEFAULT_ADMIN_EMAIL=admin@ejemplo.cl

# --- Next.js (prefijo NEXT_PUBLIC_ requerido para cliente) ---
NEXT_PUBLIC_PARSE_APP_ID=CAMBIAR_ESTO_APP_ID
NEXT_PUBLIC_PARSE_JS_KEY=CAMBIAR_ESTO_JS_KEY_MIN_32_CARACTERES
NEXT_PUBLIC_PARSE_SERVER_URL=http://localhost:5771/api/parse
