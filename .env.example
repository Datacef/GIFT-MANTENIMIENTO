# ================================================================
# Sistema de Gestión de Mantenimiento — Plantilla de variables de entorno
#
# OBLIGATORIO: copiar este archivo como .env y REEMPLAZAR TODOS los
# valores CAMBIAR_ESTO_* por credenciales propias y seguras.
#
#   cp .env.example .env      (Linux/macOS/Git Bash)
#   copy .env.example .env    (Windows CMD)
#
# El backend SE NEGARÁ A ARRANCAR si detecta valores sin actualizar
# (ver backend/validate-env.js).
#
# Generar claves fuertes:  openssl rand -hex 32
# ================================================================

# --- Parse Server ---
PARSE_APP_ID=CAMBIAR_ESTO_APP_ID
PARSE_MASTER_KEY=CAMBIAR_ESTO_MASTER_KEY_MIN_32_CARACTERES
PARSE_JS_KEY=CAMBIAR_ESTO_JS_KEY_MIN_32_CARACTERES

# --- MongoDB ---
MONGO_ROOT_USER=CAMBIAR_ESTO_USUARIO_MONGO
MONGO_ROOT_PASSWORD=CAMBIAR_ESTO_PASSWORD_MONGO_MIN_12_CARACTERES
MONGO_DB=mantenimiento

# --- URL interna de MongoDB (Docker network) ---
# Dejar comentado para usar la URI generada automáticamente desde
# MONGO_ROOT_USER / MONGO_ROOT_PASSWORD / MONGO_DB.
# PARSE_SERVER_DATABASE_URI=mongodb://USUARIO:PASSWORD@mongodb:27017/DB?authSource=admin&retryWrites=true&w=majority

# --- URLs internas (Docker network) ---
PARSE_SERVER_URL=http://backend-server:1337/parse
PARSE_PUBLIC_SERVER_URL=http://localhost:5771/api/parse

# --- Admin inicial (se crea en el primer arranque) ---
DEFAULT_ADMIN_USER=CAMBIAR_ESTO_USUARIO_ADMIN
DEFAULT_ADMIN_PASS=CAMBIAR_ESTO_PASSWORD_ADMIN_MIN_10_CARACTERES
DEFAULT_ADMIN_EMAIL=admin@ejemplo.cl

# --- Next.js (prefijo NEXT_PUBLIC_ requerido para cliente) ---
# Deben coincidir con los valores de Parse de arriba.
NEXT_PUBLIC_PARSE_APP_ID=CAMBIAR_ESTO_APP_ID
NEXT_PUBLIC_PARSE_JS_KEY=CAMBIAR_ESTO_JS_KEY_MIN_32_CARACTERES
NEXT_PUBLIC_PARSE_SERVER_URL=http://localhost:5771/api/parse

# --- Brevo (SMTP para notificaciones por correo) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_USER=CAMBIAR_ESTO_USUARIO_SMTP
BREVO_SMTP_PASS=CAMBIAR_ESTO_PASSWORD_SMTP
BREVO_SENDER_EMAIL=no-reply@ejemplo.cl
BREVO_SENDER_NAME=Sistema de Gestión de Mantenimiento
APP_PUBLIC_URL=http://localhost:5771

# --- Alertas de vencimiento (MEJ-03, opcional; default desactivado) ---
# ALERTAS_CRON_ENABLED=true
# ALERTAS_CRON_HORA=8
# ALERTAS_MANTENIMIENTO_DIAS=7
# ALERTAS_LICITACION_DIAS=30

# --- Asistente de ayuda con IA local (modulo ollamaLocal, opcional) ---
# ASISTENTE_IA_ENABLED=true
# URL base de la API FastAPI del servidor ollamaLocal (ej: http://192.168.1.50:8000)
# ASISTENTE_IA_URL=http://localhost:8000
# Token y secreto compartidos con el servidor (deben coincidir con API_TOKEN/API_SECRET del servidor)
# ASISTENTE_IA_TOKEN=CAMBIAR_ESTO_TOKEN_SEGURIDAD
# ASISTENTE_IA_SECRET=CAMBIAR_ESTO_SECRETO_HMAC_MIN_32_CARACTERES
# ASISTENTE_IA_MODEL=qwen2.5:7b

# --- Asistente IA local (contenedores ollama + llm-api incluidos en docker-compose) ---
# El LLM corre DENTRO del stack: no requiere servicios externos.
# OLLAMA_MODEL=qwen2.5:0.5b          # modelo liviano; usar p.ej. qwen2.5:7b en servidores con GPU
# LLM_API_TOKEN=CAMBIAR_ESTO_TOKEN_LLM
# LLM_API_SECRET=CAMBIAR_ESTO_SECRETO_HMAC_LLM_MIN_32_CARACTERES
# ASISTENTE_IA_ENABLED=true
# ASISTENTE_IA_URL=http://llm-api:8000   # nombre del servicio en la red docker
# ASISTENTE_IA_TOKEN=CAMBIAR_ESTO_TOKEN_LLM   # mismo valor que LLM_API_TOKEN
# ASISTENTE_IA_SECRET=CAMBIAR_ESTO_SECRETO_HMAC_LLM_MIN_32_CARACTERES  # igual que LLM_API_SECRET
# ASISTENTE_IA_MODEL=qwen2.5:0.5b
